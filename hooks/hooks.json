{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--frozen",
              "--no-sync",
              "--quiet",
              "--directory",
              "${CLAUDE_PLUGIN_ROOT}",
              "python",
              "hooks/servicenow_prompt.py"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--frozen",
              "--no-sync",
              "--quiet",
              "--directory",
              "${CLAUDE_PLUGIN_ROOT}",
              "python",
              "hooks/servicenow_script_check.py"
            ],
            "timeout": 20
          }
        ]
      }
    ]
  }
}
